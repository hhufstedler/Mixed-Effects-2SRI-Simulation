# Quintile bins of realized strength by confounding levels
bin_quintiles <- function(x) {
  if (all(is.na(x))) return(factor(rep(NA, length(x)), levels = paste0("Q", 1:5)))
  qs <- unique(stats::quantile(x, probs = seq(0, 1, 0.2), na.rm = TRUE))
  if (length(qs) == 1) return(factor(rep("Q3", length(x)), levels = paste0("Q", 1:5)))
  if (length(qs) < 6) {
    xj <- x + rnorm(length(x), sd = 1e-9)
    qs <- stats::quantile(xj, probs = seq(0, 1, 0.2), na.rm = TRUE)
  }
  cut(x, breaks = qs, include.lowest = TRUE, labels = paste0("Q", 1:5))
}

