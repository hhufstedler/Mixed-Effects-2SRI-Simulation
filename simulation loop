# ---------- Filter to assumption-violation scenarios ----------
# Pattern 1, IV strength 0.8, strong/vstrong, all violation types
appendix_md <- md_ok_all %>%
  filter(
    pattern == "1",
    iv_strength == 0.8,
    confounding %in% c("strong", "vstrong")
  ) %>%
  mutate(
    conf_lab = factor(
      ifelse(as.character(confounding) == "vstrong", "very strong", as.character(confounding)),
      levels = c("strong", "very strong"), ordered = TRUE
    ),
    violation_lab = factor(
      violation_type,
      levels = c("valid", "exclusion", "independence"),
      labels = c("Valid IV", "Exclusion Violation", "Independence Violation"),
      ordered = TRUE
    )
  )

print(table(appendix_md$conf_lab, appendix_md$violation_lab))

# ---------- Reshape to long format ----------
appendix_long <- bind_rows(
  appendix_md %>%
    transmute(conf_lab, violation_lab, method = "2SRI",
              estimate = estimate_2sri, se = se_2sri),
  appendix_md %>%
    transmute(conf_lab, violation_lab, method = "Naive",
              estimate = estimate_naive, se = se_naive)
) %>%
  mutate(
    ciL = estimate - 1.96 * se,
    ciU = estimate + 1.96 * se,
    cover = as.integer(ciL <= true_effect & ciU >= true_effect),
    method = factor(method, levels = c("2SRI", "Naive"))
  )

# ---------- Compute cell-level summaries ----------
appendix_stats <- appendix_long %>%
  group_by(conf_lab, violation_lab, method) %>%
  summarise(
    n = n(),
    mean_est = mean(estimate, na.rm = TRUE),
    
    # Relative bias (%)
    rel_bias_pct = abs(mean_est - true_effect) / abs(true_effect) * 100,
    mcse_mean    = sd(estimate, na.rm = TRUE) / sqrt(pmax(n, 1)),
    mcse_relbias = (mcse_mean / abs(true_effect)) * 100,
    rel_L        = pmax(0, rel_bias_pct - 1.96 * mcse_relbias),
    rel_U        = rel_bias_pct + 1.96 * mcse_relbias,
    
    # Empirical SE
    emp_se   = sd(estimate, na.rm = TRUE),
    mcse_emp = ifelse(n > 1, emp_se / sqrt(2 * (n - 1)), NA_real_),
    emp_L    = pmax(0, emp_se - 1.96 * mcse_emp),
    emp_U    = emp_se + 1.96 * mcse_emp,
    
    # MSE
    mse      = mean((estimate - true_effect)^2, na.rm = TRUE),
    mcse_mse = sd((estimate - true_effect)^2, na.rm = TRUE) / sqrt(pmax(n, 1)),
    mse_L    = pmax(0, mse - 1.96 * mcse_mse),
    mse_U    = mse + 1.96 * mcse_mse,
    
    # Coverage
    coverage = mean(cover, na.rm = TRUE),
    mcse_cov = sqrt(coverage * (1 - coverage) / pmax(n, 1)),
    cov_L    = pmin(pmax(coverage - 1.96 * mcse_cov, 0), 1),
    cov_U    = pmin(pmax(coverage + 1.96 * mcse_cov, 0), 1),
    
    .groups = "drop"
  ) %>%
  mutate(
    row_label = paste0(violation_lab, " - ", method),
    row_label = factor(row_label, levels = rev(c(
      "Valid IV - 2SRI", "Valid IV - Naive",
      "Exclusion Violation - 2SRI", "Exclusion Violation - Naive",
      "Independence Violation - 2SRI", "Independence Violation - Naive"
    )))
  )

