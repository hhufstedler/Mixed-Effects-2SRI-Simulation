fmt_pm <- function(x, se, digits_val = 3, digits_se = 3, pct = FALSE){
  if (pct) {
    paste0(sprintf("%.1f\\%%", 100*x), " (", sprintf("%.1f\\%%", 100*se), ")")
  } else {
    paste0(formatC(x, format = "f", digits = digits_val),
           " (", formatC(se, format = "f", digits = digits_se), ")")
  }
}

