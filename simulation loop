      strip.text   = ggplot2::element_text(size = base_size - 2),
      plot.margin  = ggplot2::margin(5, 5, 5, 5)
    )
}

# combined appendix panels
create_readable_panel <- function(base_plot, metric_name, filename_base, use_vertical = FALSE) {
  
  # 1) All-patterns plot
  all_patterns_plot <- base_plot + clean_theme() + ggplot2::labs(title = "All Patterns", subtitle = NULL)
  
  # 2) Pattern-specific plots 
  pattern_plots <- vector("list", length(patterns))
  for (i in seq_along(patterns)) {
    pat <- patterns[i]
    if (metric_name %in% c("Distribution of Estimates",
                           "Distribution of Standard Errors",
                           "Estimates vs Standard Errors")) {
      filtered_data <- dplyr::filter(long, pattern == pat)
      pattern_plots[[i]] <- base_plot %+% filtered_data + clean_theme() +
        ggplot2::labs(title = paste("Pattern", pat), subtitle = NULL)
      
    } else if (metric_name %in% c("Method Comparison",
                                  "Bland-Altman Agreement")) {
      filtered_data <- dplyr::filter(wide_methods, pattern == pat)
      pattern_plots[[i]] <- base_plot %+% filtered_data + clean_theme() +
        ggplot2::labs(title = paste("Pattern", pat), subtitle = NULL)
      
    } else if (metric_name == "Confidence Interval Coverage") {
      filtered_data <- dplyr::filter(zip_df, pattern == pat)
      pattern_plots[[i]] <- base_plot %+% filtered_data + clean_theme() +
        ggplot2::labs(title = paste("Pattern", pat), subtitle = NULL)
      
    } else {
      # default to long format
      filtered_data <- dplyr::filter(long, pattern == pat)
      pattern_plots[[i]] <- base_plot %+% filtered_data + clean_theme() +
        ggplot2::labs(title = paste("Pattern", pat), subtitle = NULL)
    }
  }
  
  # 3) Arrange: "All Patterns" + one per pattern 
  panels <- c(list(all_patterns_plot), pattern_plots)
  
  # layout sizing 
  n_panels <- length(panels)
  if (use_vertical) {
    # vertical layout with up to three panels per row
    ncol <- min(3, n_panels)
    nrow <- ceiling(n_panels / ncol)
    plot_width  <- 8 * ncol
    plot_height <- 6 * nrow + 2
    panel_fig <- patchwork::wrap_plots(panels, ncol = ncol)
  } else {
    # horizontal row with up to five panels per row
    ncol <- min(5, n_panels)
    nrow <- ceiling(n_panels / ncol)
    plot_width  <- 6 * ncol     # ~6 inches per panel
    plot_height <- 5 * nrow + 2 
    panel_fig <- patchwork::wrap_plots(panels, ncol = ncol)
  }
  
  # 4) Legend extraction
  legend <- tryCatch(
    cowplot::get_legend(base_plot + ggplot2::theme(legend.position = "bottom")),
    error = function(e) NULL
  )
  
  if (!is.null(legend)) {
    panel_fig <- panel_fig / legend + patchwork::plot_layout(heights = c(10, 1))
  }
  
  panel_fig <- panel_fig + patchwork::plot_annotation(
    title = metric_name,
    theme = ggplot2::theme(plot.title = ggplot2::element_text(size = 20, hjust = 0.5, face = "bold"))
  )
  
  save_plot(panel_fig, paste0(filename_base, "_5panel_readable.png"),
            w = plot_width, h = plot_height)
  panel_fig
}

