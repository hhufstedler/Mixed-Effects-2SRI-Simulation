norm_conf <- function(x) {
  x2 <- tolower(trimws(as.character(x)))
  dplyr::case_when(
    x2 %in% c("very strong","verystrong","v strong","v-strong","v_strong",
              "v.strong","very_strong","vstrong") ~ "vstrong",
    x2 %in% c("strong","str")   ~ "strong",
    x2 %in% c("moderate","mod","med") ~ "moderate",
    x2 %in% c("weak","wk")      ~ "weak",
    TRUE                        ~ x2
  )
}

